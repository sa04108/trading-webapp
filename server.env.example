# Compose 설정이다. 앱 비밀값은 app.env에 둔다.
DOMAIN=trading.hyunbbai.com
SERVER_IMAGE=ghcr.io/sa04108/quant-platform:latest
# G3 N100 4코어 / RAM 16GB 기준. API와 모든 계산 자식의 합산 상한이다.
SERVER_CPUS=3.0
SERVER_MEMORY=10g
# 기존 Traefik의 Docker provider 네트워크와 HTTPS entryPoint 이름이다.
TRAEFIK_NETWORK=infra-proxy
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# 기존 인증서 resolver 이름. 미사용(별도 제공 인증서 등)이면 비워 둔다.
TRAEFIK_CERT_RESOLVER=letsencrypt
# 전달 IP를 신뢰할 Traefik의 정확한 내부 IP. 비워 두면 전달 헤더를 신뢰하지 않는다.
TRAEFIK_TRUSTED_IPS=
