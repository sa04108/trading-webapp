# scripts/server.sh init이 SESSION_SECRET을 최초 한 번 생성한다.
# 값은 따옴표 없이 적는다. Compose raw 형식이므로 $도 그대로 전달된다.
NODE_ENV=production
MAX_QUEUED_BACKTESTS=20
LOG_LEVEL=info
LIVE_TRADING_ENABLED=false
SYNC_MIN_FREE_DISK_MB=2048
# 미사용 키는 빈 값으로 활성화하지 않는다.
#KRX_API_KEY=
#KRX_APPROVAL_EXPIRY=2027-08-03
#DART_API_KEY=
#FRED_API_KEY=
#TOSS_CLIENT_ID=
#TOSS_CLIENT_SECRET=
