# /etc/quant-platform/worker.env (chmod 600, root:root)
# 이 파일의 저장소 밖 사본을 QP_WORKER_ENV_FILE로 bootstrap-worker.sh에 전달한다.
# Worker 운영 경로는 Docker Compose 하나이며 호스트에 Node/systemd app unit을 설치하지 않는다.
NODE_ENV=production

# Worker는 이 HTTPS 주소로만 outbound 연결한다. app과 worker에 같은 release를 배포한다.
BACKTEST_APP_URL=https://quant.example.com
# app.env의 BACKTEST_WORKER_TOKEN과 같은 32자 이상 난수
BACKTEST_WORKER_TOKEN=<48_BYTE_RANDOM_VALUE>
BACKTEST_WORKER_ID=worker-pc-1

# 이 값이 전용 worker 한 대의 실제 동시 실행 수다. 처음에는 1로 시작해 telemetry로 올린다.
BACKTEST_WORKER_CONCURRENCY=1
# container 내부 Worker 전용 bind mount. 다른 값은 bootstrap이 거부한다.
BACKTEST_WORK_ROOT=/var/lib/quant-backtest-worker
# 빈 큐에서는 이 시간 동안 long polling한다. 0은 tight polling을 만들므로 허용하지 않는다.
BACKTEST_CLAIM_WAIT_SECONDS=25
BACKTEST_HEARTBEAT_SECONDS=5
LOG_LEVEL=info
