# 스펙 §28 — /etc/quant-platform/app.env (chmod 600, root:root)
NODE_ENV=production

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

DATABASE_PATH=/var/lib/quant-platform/app.sqlite
DATA_ROOT=/var/lib/quant-platform/market-data
IMPORT_ROOT=/var/lib/quant-platform/imports
EXPORT_ROOT=/var/lib/quant-platform/exports
TEMP_ROOT=/var/lib/quant-platform/temp

MAX_CONCURRENT_BACKTESTS=1
MAX_QUEUED_BACKTESTS=20
DUCKDB_THREADS=1
DUCKDB_MEMORY_LIMIT=384MB

# openssl rand -base64 48
SESSION_SECRET=<48_BYTE_RANDOM_VALUE>
SESSION_IDLE_TIMEOUT_SECONDS=43200
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800

LOG_LEVEL=info
TRUST_PROXY_LOOPBACK=true

LIVE_TRADING_ENABLED=false

# 토스증권 Open API (D-018·D-020). 둘 다 설정하거나 둘 다 비워야 한다 —
# 한쪽만 있으면 부팅이 ConfigError 로 실패한다. 발급: WTS 설정 > Open API.
# 허용 IP 등록제 — 서버 고정 IP 를 포털에 먼저 등록할 것.
#TOSS_CLIENT_ID=
#TOSS_CLIENT_SECRET=
# 기본값: https://openapi.tossinvest.com
#TOSS_BASE_URL=
# 동기화 디스크 가드 (MB, 기본 2048)
#SYNC_MIN_FREE_DISK_MB=2048

# DART OpenAPI (전자공시, facts:sync CLI). 미설정이면 재무 수집이 비활성 —
# 봉 데이터 동기화에는 영향이 없다. 발급: https://opendart.fss.or.kr
# 주의: 주석을 풀고 값을 비워 두면(DART_API_KEY=) 부팅이 ConfigError 로 실패한다.
# 안 쓸 거면 줄을 주석 상태로 남길 것. 값을 바꾼 뒤에는 restart 가 필요하다 (스펙 §28.1).
# CLI 는 이 파일을 자동으로 읽지 않는다 — systemd-run 으로 실행할 것 (스펙 §28.2).
#DART_API_KEY=
# 기본값: https://opendart.fss.or.kr
#DART_BASE_URL=

# KRX Open API (정보데이터시스템, 과거 유니버스). 미설정이면 과거 유니버스 모드가 비활성 —
# 다른 데이터 경로는 영향이 없다. 둘 다 설정하거나 둘 다 비워야 한다 —
# 한쪽만 있으면 부팅이 ConfigError 로 실패한다. 값을 바꾼 뒤에는 restart 가 필요하다 (스펙 §28.1).
# 주의: 주석을 풀고 값을 비워 두면(KRX_API_KEY=) 부팅이 ConfigError 로 실패한다.
# 안 쓸 거면 줄을 주석 상태로 남길 것.
#KRX_API_KEY=
#KRX_APPROVAL_EXPIRY=2027-08-03
# 기본값: https://data-dx.krx.co.kr
#KRX_BASE_URL=
