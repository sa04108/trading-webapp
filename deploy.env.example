# pnpm run deploy가 읽는 로컬 SSH 배포 설정이다. deploy.env로 복사해 사용한다.
# 애플리케이션 runtime 비밀값은 원격 /etc/quant-platform/app.env와
# /etc/quant-platform/worker.env에서 관리하며 이 파일에 복사하지 않는다.

# app SSH — 무인자 배포와 --target app|all에 필요하다.
QP_APP_HOST=ubuntu@app.example.com
# HOST에 user@를 포함했다면 비워 둔다.
QP_APP_SSH_USER=
# ssh-agent 또는 ~/.ssh/config의 IdentityFile을 쓰면 비워 둔다.
QP_APP_SSH_KEY=~/.ssh/app.pem
QP_APP_SSH_PORT=22
# accept-new: 새 키만 자동 등록, yes: known_hosts와 일치해야 함, no: 확인 생략
QP_APP_SSH_HOST_KEY=accept-new
# 직접 접속할 수 있으면 아래 두 값은 비워 둔다.
QP_APP_SSH_JUMP=
QP_APP_SSH_OPTS=

# worker SSH — HOST를 채우면 무인자 배포가 app+worker를 선택한다.
QP_WORKER_HOST=
QP_WORKER_SSH_USER=
QP_WORKER_SSH_KEY=
QP_WORKER_SSH_PORT=22
QP_WORKER_SSH_HOST_KEY=accept-new
QP_WORKER_SSH_JUMP=
QP_WORKER_SSH_OPTS=
