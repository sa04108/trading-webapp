# pnpm run deploy가 읽는 로컬 배포 설정이다. deploy.env로 복사해 사용한다.
# 애플리케이션 runtime 비밀값은 서버 /etc/quant-platform/app.env와 Worker의
# /etc/quant-platform/worker.env에서 관리하며 이 파일에 복사하지 않는다.

# 0: 운영 서버만 배포, 1: 같은 release를 운영 서버와 Worker에 함께 배포
QP_DEPLOY_WORKER=0

# 정상 배포 성공 뒤 남길 과거 산출물 개수. 둘 다 0이면 현재 release만 남긴다.
# 자동 롤백 실패로 .deploy-failed가 붙은 복구 산출물은 이 개수와 무관하게 보존한다.
QP_DEPLOY_KEEP_RELEASES=0
QP_DEPLOY_KEEP_DB_SNAPSHOTS=0

# 운영 서버 SSH
QP_SERVER_HOST=ubuntu@server.example.com
# HOST에 user@를 포함했다면 비워 둔다.
QP_SERVER_SSH_USER=
# ssh-agent 또는 ~/.ssh 기본 키를 쓰면 비워 둔다.
QP_SERVER_SSH_KEY=~/.ssh/server.pem
QP_SERVER_SSH_PORT=22
# accept-new: 새 키만 자동 등록, yes: known_hosts와 일치해야 함, no: 확인 생략
QP_SERVER_SSH_HOST_KEY=accept-new
# 직접 접속할 수 있으면 아래 두 값은 비워 둔다.
QP_SERVER_SSH_JUMP=
QP_SERVER_SSH_OPTS=

# Worker SSH — QP_DEPLOY_WORKER=1일 때만 읽는다.
QP_WORKER_HOST=ubuntu@worker.example.com
QP_WORKER_SSH_USER=
QP_WORKER_SSH_KEY=~/.ssh/worker.pem
QP_WORKER_SSH_PORT=22
QP_WORKER_SSH_HOST_KEY=accept-new
QP_WORKER_SSH_JUMP=
QP_WORKER_SSH_OPTS=

# 같은 Git SHA의 정상 Worker는 기본적으로 no-op한다. 강제 재배포할 때만 1로 바꾼다.
QP_FORCE_WORKER_DEPLOY=0
