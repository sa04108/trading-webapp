# pnpm run deploy가 읽는 로컬 SSH 배포 설정이다. deploy.env로 복사해 사용한다.
# 외부 API 비밀값은 운영 서버의 /etc/quant-platform/app.env에서 관리한다.
# 계산 장치에는 SSH로 배포하지 않는다. 다운로드 클라이언트를 서버 릴리스에 포함한다.

# SSH — 모든 배포에 필요하다.
HOST=ubuntu@server.example.com
# HOST에 user@를 포함했다면 비워 둔다.
SSH_USER=
# ssh-agent 또는 ~/.ssh/config의 IdentityFile을 쓰면 비워 둔다.
SSH_KEY=~/.ssh/quant.pem
SSH_PORT=22
# accept-new: 새 키만 자동 등록, yes: known_hosts와 일치해야 함, no: 확인 생략
SSH_HOST_KEY=accept-new
# 직접 접속할 수 있으면 아래 두 값은 비워 둔다.
SSH_JUMP=
SSH_OPTS=
