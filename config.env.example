# 운영 설정 원본. scripts/server.sh init이 config.env를 권한 600으로 만든다.
# KEY=value 한 줄 형식이며 따옴표·$·#·역슬래시는 값 그대로다. source/eval하지 않는다.
# 미사용 선택 키는 주석으로 둔다. 같은 키를 두 번 쓰거나 알 수 없는 키를 쓰면 거부한다.

# 서버·Traefik: Compose에만 전달하며 앱 환경에는 넣지 않는다.
DOMAIN=trading.hyunbbai.com
SERVER_IMAGE=quant-platform:local
SERVER_CPUS=3.0
SERVER_MEMORY=10g
TRAEFIK_NETWORK=infra-proxy
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# 별도 인증서를 공급하면 빈 값으로 둔다.
TRAEFIK_CERT_RESOLVER=letsencrypt
# 신뢰할 Traefik 내부 IP/CIDR만 지정한다. 비우면 전달 IP 헤더를 신뢰하지 않는다.
TRAEFIK_TRUSTED_IPS=

# 앱 인증: init이 새 설치에서만 생성한다. 기존 DB의 SESSION_SECRET은 그대로 옮긴다.
#SESSION_SECRET=
#SESSION_IDLE_TIMEOUT_SECONDS=43200
#SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800

# 앱 운영: NODE_ENV, 내부 포트·바인딩과 데이터 경로는 배포 도구·이미지가 관리한다.
MAX_QUEUED_BACKTESTS=20
LOG_LEVEL=info
LIVE_TRADING_ENABLED=false
SYNC_MIN_FREE_DISK_MB=2048
#AUDIT_LOG_RETENTION_DAYS=90
#NOTIFICATION_RETENTION_DAYS=7
#KRX_DAILY_CALL_BUDGET=9000

# 데이터 공급자: 사용하는 키의 주석만 해제한다.
#KRX_API_KEY=
#KRX_APPROVAL_EXPIRY=2027-08-03
#KRX_BASE_URL=https://data-dbg.krx.co.kr
#DART_API_KEY=
#DART_BASE_URL=https://opendart.fss.or.kr
#FRED_API_KEY=
#FRED_BASE_URL=https://api.stlouisfed.org
#TOSS_CLIENT_ID=
#TOSS_CLIENT_SECRET=
#TOSS_BASE_URL=https://openapi.tossinvest.com

# 기본은 서버 이미지에 포함된 같은 릴리스의 Agent digest다. 특별히 바꿀 때만 지정한다.
#AGENT_CONTAINER_IMAGE=ghcr.io/sa04108/quant-agent@sha256:<digest>
