{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/server", "src/runtime", "src/workers", "src/agent", "src/shared", "scripts", "tests"],
  // 테스트 계층과 관계없이 JSX 테스트는 웹의 JSX·DOM 설정으로 검사한다.
  "exclude": ["tests/e2e", "tests/**/*.test.tsx"]
}
